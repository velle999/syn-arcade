pkgbase = syn-arcade
	pkgdesc = SynapseOS game assistant: in-game overlay, controller setup and gaming shortcuts
	pkgver = 0.1.0
	pkgrel = 59
	url = https://github.com/velle999/SYNAPSE
	arch = x86_64
	license = GPL-2.0-or-later
	makedepends = meson
	makedepends = ninja
	makedepends = gcc
	makedepends = wayland
	makedepends = sdl3
	depends = glibc
	depends = wayland
	depends = curl
	depends = mangohud
	depends = projectm-pulseaudio
	optdepends = quickshell: the graphical window (syn-arcade gui) AND big screen mode
	optdepends = wtype: big screen mode’s on-screen keyboard types through it — without it the keyboard draws and types nothing
	optdepends = synui: the compositor the gaming shortcuts are installed into. ⚠ `big mouse` needs a synui new enough to offer zwlr_virtual_pointer_manager_v1 (0.1.0-327 or later); it says so if not. ⚠ The Recent bar needs one new enough to answer `synctl recent` (0.1.0-489 or later) — the list of what this desktop has opened is the compositor’s, because a window mapping is the only thing every way of launching something has in common. An older synui simply draws no Recent bar
	optdepends = firefox: the Web tile, and where a headline or a media server opens
	optdepends = steam: the game library and Big Picture tiles in big screen mode
	optdepends = gamescope: `syn-arcade fit` — the nested compositor that makes a low-resolution game fill the screen, and `big steam --gamescope` for a TV whose resolution is not the desktop’s
	optdepends = retroarch: appears as a tile in big screen mode
	optdepends = syntty: the Terminal tile (kitty, foot, alacritty and xterm are used in that order if it is absent)
	optdepends = cliamp: THE music player for big screen mode, and packaged here since 0.1.0-23. It is the only one that can be DRIVEN rather than launched — it runs headless and takes transport over a socket — so with it the Music tile plays without opening a window, the Start menu gets a Now Playing row with a meter, a Music Source picker (Plex, YouTube Music, Spotify, local files, radio) and a browsable Plex library. Every other player is a window somebody has to get out of with a gamepad
	optdepends = strawberry: the Music tile if cliamp is not installed (elisa, amberol, rhythmbox, lollypop, clementine, audacious, deadbeef, quodlibet, tauon, plexamp, spotify and vlc are tried in that order). Pick any of them with `syn-arcade big player <name>`, or the Big screen tab of the window
	optdepends = plex-desktop: the Plex tile — a Plex server on the network is found by broadcast either way
	optdepends = jellyfin-media-player: the Jellyfin tile, likewise
	optdepends = sdl2-compat: SDL2 games that read the controller mappings
	optdepends = sdl3: SDL3 games read the mappings — and `syn-arcade map learn` needs it to WRITE one, because the GUID and the button numbers in a mapping are SDL’s own
	optdepends = mpv: the disc tile. A Blu-ray, a DVD or an audio CD in the drive appears on the media shelf, named after the disc, and plays full screen through mpv — which Arch already builds against libdvdnav, libbluray and libcdio, so bd://, dvd:// and cdda:// need nothing else. big screen mode starts it with a JSON IPC socket and drives it over that, which is what makes ⏭ and ⏮ skip a CHAPTER rather than a playlist entry
	optdepends = libdvdcss: encrypted commercial DVDs. libdvdread dlopens it by soname at the moment a disc is opened, so without it an ordinary rented film stops with an error and a home-made disc plays perfectly — `syn-arcade big disc` names it when it is missing
	optdepends = libaacs: encrypted commercial Blu-rays, the same way. ⚠ It also needs a key database, which no distribution ships
	optdepends = util-linux: `syn-arcade big disc eject` runs eject(1). It is part of the base system on any SynapseOS install; named for the machines where it is not
	source = syn-arcade-0.1.0.tar.gz::https://github.com/velle999/syn-arcade/releases/download/0.1.0-59/syn-arcade-0.1.0.tar.gz
	sha256sums = SKIP

pkgname = syn-arcade
